<group name="cowrie,honeypot,">

  <rule id="100001" level="10">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.session.connect$</field>
    <description>Cowrie: New SSH connection to honeypot from $(src_ip)</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100002" level="12">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.login.failed$</field>
    <description>Cowrie: Failed login attempt - user $(username)</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100003" level="14">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.login.success$</field>
    <description>Cowrie: Successful honeypot login - user $(username) from $(src_ip)</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100004" level="12">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.command.input$</field>
    <description>Cowrie: Attacker command input: $(input)</description>
  </rule>

  <rule id="100005" level="15">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie.session.file_download$</field>
    <description>Cowrie: Malware/file download attempted via honeypot</description>
    <group>malware,</group>
  </rule>

</group>
